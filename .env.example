# Copy to .env and set values from the Supabase dashboard.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — only for `npm run db:setup` (Cloud Agent / local CLI). Do not expose to the browser build.
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@db.[ref].supabase.co:5432/postgres
